PORT=5000
NODE_ENV=development

# MongoDB: local or Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/tattoo_selection

# Generate a long random string, e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# Frontend origin allowed by CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Image storage: set all three for Cloudinary (recommended / production).
# If left blank, images are stored in backend/uploads (development only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Max upload size in MB
MAX_IMAGE_MB=5

# Optional AI tattoo-name suggestions for admin folder imports (Google Gemini)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Used only by `npm run create-admin` (you can also pass them interactively)
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
